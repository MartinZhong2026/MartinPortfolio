{
  "name": "martin-zhong-pool-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Martin Zhong's interactive swimming-pool portfolio: prerendered React pages + a real-time WebGL water island.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs --port 4321",
    "typecheck": "tsc --noEmit",
    "test:content": "node scripts/check-content.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "test:about": "node scripts/check-about-layout.mjs",
    "capture": "node scripts/capture.mjs",
    "test": "npm run typecheck && npm run build && npm run test:content",
    "test:v62:source": "node scripts/check-v62-source.mjs"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.184.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.184.0",
    "esbuild": "0.28.2",
    "playwright": "^1.56.0",
    "typescript": "6.0.3"
  }
}
